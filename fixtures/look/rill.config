# RILL — ~/.config/rill/config
# Ghostty line grammar (not TOML). Unknown keys are ignored.
# Override path: RILL_CONFIG. Bundled fallback: host-surface.toml (ADR 0017).

# --- Look -------------------------------------------------------------------
theme = Catppuccin Mocha
font-family = JetBrainsMono Nerd Font
font-size = 16
font-family-fallback = JetBrainsMonoNL Nerd Font
font-family-fallback = Menlo
split-divider-color = #45475a
window-padding-x = 8
window-padding-y = 8
background-opacity = 0.95
macos-option-as-alt = true

# Parsed, not applied (ADR 0017): NSWindow.alphaValue washes the surface;
# NSVisualEffectView blanks it. Opacity/blur are compositor (Chip 1).
# background-blur-radius = 20

# --- Not yet (ignored). Copied from Ghostty so they are not lost. -----------
# working-directory = ~/Developer
# mouse-hide-while-typing = true
# scrollback-limit = 100000
# shell-integration = zsh
# surface-tab-bar-font-size = 14
# sidebar-font-size = 14
# keybind = global:cmd+alt+grave_accent=toggle_quick_terminal
