# Unicode data pin for Chip 1 East Asian Width and Mn/Me clustering.
# ADR 0035 D2, ADR 0002 D7.
#
# Source is Python's unicodedata (no network in fast.yml). Moving this pin is
# its own PR: regenerate crates/vt-engine/src/east_asian_width.rs and re-run
# T-CHIP1-WIDTH. Never a side effect of a clean checkout.
#
# scripts/gen-east-asian-width.py refuses to emit if unidata_version mismatches.
source = python3 unicodedata
unidata_version = 16.0.0
east_asian_width_sha256 = b78ba7abfe465c087e6bb2b7d0e3618c33a59a3f323ee6e7576f822be65d1c95
